.models/
artifacts/
__pycache__/
*.pyc
.DS_Store

# Продажные презентации — не для публичного репозитория
*.pptx

# Обучающий контур и лаборатория качества — не для публичного репозитория
training/
.corpus/

# ДАННЫЕ КЛИЕНТА. Репозиторий публичный — сюда не должно попасть ничего,
# что взято из архива недропользователя.
# .work/ — тексты документов, нарезка и разметка (десятки МБ реальных
#          буровых журналов, актов, каталогов скважин).
# out/   — выгрузки прогонов распознавания.
# adjudication*.json и *-why.json — словари РЕАЛЬНЫХ значений из документов
#          клиента (какие месторождения, скважины и лицензии у него есть)
#          вместе с обоснованиями, где нередко процитирован контекст.
# *-progress.jsonl, *-misses.json, *-gold.json, *-unconfirmed.json — то же
#          самое, но в виде промежуточных выгрузок замера.
.work/
out/
# Оснастка доступа к машине клиента: боевые адреса, маршрут через runner-exec,
# точки загрузки. Публичному репозиторию не нужна, а раскрывает инфраструктуру.
scripts/ec3090/
scripts/**/adjudication*.json
scripts/**/*-why.json
scripts/**/*-progress.jsonl
**/*-misses.json
**/*-gold.json
**/*-unconfirmed.json
